# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/

# Environments
.venv/
venv/
*.env

# macOS
.DS_Store

# Model files (large binaries — opzionale, rimuovi se vuoi versionarli)
# *.joblib

# Dataset generati (rigenerabili con psxg/build_dataset.py)
xgoals_project/datasets/

# Analytics Cup: la submission è un fork separato di PySport/analytics_cup_*,
# con la sua history e il suo remote. Sta dentro il workbench solo per comodità
# sul disco — non va versionata qui.
analytics_cup_project/submission/

# Analytics Cup: i paper della letteratura. Sono ~24 MB di PDF, quasi tutti
# sotto copyright dell'editore. Quello che vale sta nelle schede in
# analytics_cup_project/notes/letteratura/, che sono versionate.
analytics_cup_project/docs/

# Analytics Cup: configurazione locale di Obsidian (vault aperto sul workbench).
# workspace.json cambia a ogni apertura: non è materiale di progetto.
analytics_cup_project/.obsidian/

# Analytics Cup: venv del workbench (Python 3.12.8), creato da requirements.txt.
analytics_cup_project/.venv/

# Analytics Cup: i video dei post si rigenerano dallo script che li produce.
analytics_cup_project/figures/post/*.mp4

# Analytics Cup: dati intermedi dei report, rigenerabili con scripts/ (~6 MB l'uno).
analytics_cup_project/reports/*.csv
