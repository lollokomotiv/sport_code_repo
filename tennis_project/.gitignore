# Dati grezzi e derivati: rigenerabili con lib/download.py, non si versionano
data/raw/*
data/processed/*
!data/**/.gitkeep

# Output pesanti delle analisi
*.parquet
*.joblib
*.pkl
models/

# Immagini: ignorate di default, tranne i grafici delle analisi concluse.
# Quelli si versionano — sono il risultato visibile del lavoro, pesano decine di
# KB, e senza di loro i README delle analisi mostrano link rotti su GitHub.
*.png
*.jpg
*.svg
!analyses/**/figures/*.png
!analyses/**/figures/*.svg

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Ambiente / OS
.env
.DS_Store
